# Almacenamiento (Vercel → Storage → Blob, acceso Private, región Frankfurt). Al conectarlo al proyecto,
# Vercel pone solo las credenciales (OIDC). Fuera de Vercel se usa el token:
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx
# Contraseña de /panel
PANEL_PASSWORD=una-contraseña-larga
# Solo para pruebas locales sin Vercel:
# STORE=memory
